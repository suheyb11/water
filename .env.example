# Copy to .env and fill in. Never commit .env. On Vercel set the same variables in
# Project > Settings > Environment Variables.

# Supabase > Connect > ORMs/Connection string. Password with special characters (@ : / # ?) must be URL-encoded.
# App runtime: Transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Prisma Migrate: Session pooler (port 5432) or the direct connection.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Used only by `npm test` (the tests EMPTY its tables). Must be a database named waterportal_test,
# or a separate schema: add ?schema=test to a session/direct URL. Never the real data.
TEST_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=test"

# Random secret (e.g. `openssl rand -base64 48`)
AUTH_SECRET=""

# Business day boundaries for reports (IANA timezone)
BUSINESS_TIMEZONE="Africa/Mogadishu"

# "true" when the portal is served over HTTPS (always on Vercel)
COOKIE_SECURE="false"
