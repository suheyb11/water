# Copy to .env and fill in. Never commit .env.

# SQL Server (local instance SQLEXPRESS on TCP 1433). Put the password in {braces} if it contains ; or =
DATABASE_URL="sqlserver://localhost:1433;database=WaterPortal;user=water_app;password={CHANGE_ME};encrypt=true;trustServerCertificate=true"

# Separate database used only by `npm test` (emptied by the tests). Must be named WaterPortal_Test.
TEST_DATABASE_URL="sqlserver://localhost:1433;database=WaterPortal_Test;user=water_app;password={CHANGE_ME};encrypt=true;trustServerCertificate=true"

# Random secret (e.g. `openssl rand -base64 48`)
AUTH_SECRET=""

# Business day boundaries for reports (IANA timezone)
BUSINESS_TIMEZONE="Africa/Mogadishu"

# Set to "true" when the portal is served over HTTPS (secure session cookie)
COOKIE_SECURE="false"
